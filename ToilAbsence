async function getIncreasedToil(value) {
    let convertedValue = (parseInt(value) + 1);
    return convertedValue.toString();
}

function criteria(text) {
    console.log(text)
}

async function selectTimeFromPicker(hours, minutes) {
  let timePicker = await global.driver.elementsByClassName("XCUIElementTypePickerWheel");
  await testingUtilities.sleepNormal();
  if (await testingUtilities.checkViewHasText("toolbar_title", "How long?") == true) {
    timePicker[0].sendKeys(hours);
    timePicker[2].sendKeys(minutes);
  } else {
    timePicker[0].sendKeys(hours);
    timePicker[1].sendKeys(minutes);
  }
}

 async function locateToilRecord(date) {
  var isToilVisible = await testingUtilities.isElementPresent(date);
  while (isToilVisible == false) {
    await testingUtilities.scrollDown(interactions.scrollValue.SHORT);
    await testingUtilities.sleepNormal();
    if (await testingUtilities.isElementPresent(date) == true) {
      isToilVisible = true;
    }
  }
  await testingUtilities.sleepShort();
  await interactions.clickOn(date);
} 

//if there are cancelled records this will fail as the dates may overlap

async function assertToilSummary(date, expectedStart, expectedEnd, checkStatus, checkDuration, expectedStatus, expectedDuration) {
  await assertions.viewHasText("toolbar_title", "Summary");
  await assertions.viewHasText("summary_absence_type", "TOIL absence");
  await assertions.viewIsPresent("When?");
  await assertions.viewIsPresent("What time?");
  await assertions.viewHasText("start_date", date);
  await assertions.viewHasText("start_day_option", expectedStart);
  await assertions.viewHasText("end_day_option", expectedEnd);
  if (checkStatus == true) await assertions.viewIsPresent(`${expectedStatus}`);
  if (checkDuration == true) await assertions.viewHasText("duration", expectedDuration);
}

async function selectValidToilDays(startDay) {
  var isValid = false;
  var day = startDay;
  while (!isValid) {
    await interactions.clickOnByText("date_picker", day.toString());
    if (day != startDay) {
      await interactions.clickOnByText("date_picker", day.toString());
    }
    await testingUtilities.sleepNormal();
    if (await testingUtilities.isElementPresent("No conflicts") == false) {
      console.log("Conflicts present, checking another day..");
      await interactions.scrollDown(interactions.scrollValue.SHORT);
      day = day + 1;
    } else if (await testingUtilities.checkViewHasText("toolbar_subtitle", "This is not a working day")) {
      console.log("Checking next day...");
      day = day + 1;
    } else {
      isValid = true;
    }
  }
}
