async function selectSicknessTime(amount) {
    let sicknessTimes = await global.driver.elementsById("absence_description_TV");
    await sicknessTimes[amount].click();
}

async function getIncreasedSicknessValue(value) {
    let convertedValue = (parseInt(value) + 1);
    return convertedValue.toString();
}

function criteria(text) {
    console.log(text)
}

async function selectValidDays(startDay, isVhe = false) {
    var isValid = false;
    var day = startDay;
    while (!isValid) {
      await interactions.clickOnByText("date_picker", day.toString());
      if (day != startDay) {
        await interactions.clickOnByText("date_picker", day.toString());
      }
      await testingUtilities.sleepNormal();
      if (isVhe == true) {
          isValid = true;
      }
      else if (await testingUtilities.checkViewHasText("toolbar_subtitle", "This is not a working day")) {
        console.log("Checking next day...");
        day = day + 1;
      } else {
        isValid = true;
      }
    }
  }
